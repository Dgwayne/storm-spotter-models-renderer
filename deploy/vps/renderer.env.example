# /etc/stp-renderer/renderer.env  — mode 0600, NEVER committed.
#
# Same four values the GitHub workflows read from repository secrets
# (B2_BUCKET / B2_S3_ENDPOINT / B2_KEY_ID / B2_APP_KEY). rclone reads the
# key pair from its own config file as well; bootstrap does not write that,
# because writing credentials is a deliberate act — see README.md.
#
# Copy this file, fill it in, and confirm:
#   sudo chmod 0600 /etc/stp-renderer/renderer.env
#   sudo -u ubuntu rclone lsd r2:$R2_BUCKET/v1/ | head

R2_BUCKET=
R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public origin the manifest is read back from. Cloudflare serves it, so a
# read here never reaches B2 and never costs a Class B/C call.
MODELS_BASE_URL=https://models.dgwaynes.com/v1

# How many products render concurrently. 4 on 2 OCPU; raise with the box.
OBS_JOBS=4

# 1 = the single-process GDAL pass (scripts/mrms_render_one.py).
# 0 = the historical five-spawn chain. Both produce the same PNG; keep this
#     switch reachable so a suspect frame can be re-rendered the old way
#     without a deploy.
OBS_SINGLE_PASS=1
