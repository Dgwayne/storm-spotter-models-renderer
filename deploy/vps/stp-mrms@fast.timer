[Unit]
Description=MRMS fast tier every 3 min (41 products, ~2 min at source)

[Timer]
Unit=stp-mrms@fast.service
# CADENCE HISTORY, and read the margin note before changing this again.
#
#   *:0/2  until 2026-08-17  (on 4 OCPU)
#   *:0/4  2026-08-17        (proving the box fits 2 OCPU / Always Free)
#   *:0/3  2026-08-17        (current; operator preference, measured below)
#
# Measured on the live 2-core box, elapsed per tick vs the tier's budget:
#
#   cadence | worst tick     | % of budget | load avg (2 cores)
#   4 min   | 141s of 240s   |     59%     | 1.18 / 1.51 / 1.89
#   3 min   | 153s of 180s   |     85%     | 3.71 / 4.02 / 3.20
#
# 3 min held over 9 consecutive ticks with ZERO skips and no divergence, but
# it spends most of the safety margin to do it. The measurable freshness gain
# is small: et18 live lag sampled every 45s across 9 samples averaged 2.46 min
# (total age 4.82 min), and the theoretical improvement over 4 min is only
# ~0.5 min, which is smaller than the sawtooth's own 0.0-4.1 min swing. The
# operator reports a perceptible difference on device and chose to keep it.
#
# WATCH (corrected 2026-08-18): an earlier version of this comment said to
# grep for `status=skipped reason=previous-tick-still-running`. That string
# NEVER FIRES for an overrun. systemd refuses to start a second copy of a
# oneshot unit that is still active, so run-tier.sh never runs and never logs
# its flock message. In 24 h of real overruns it appeared zero times.
#
# The signals that DO fire:
#   1. a start time not on a 3-minute boundary (systemd releases the held
#      trigger the moment the long tick finishes), e.g.
#        journalctl -u 'stp-mrms@fast' -o short-iso | grep Starting
#      12 such lost slots were observed on 2026-08-18.
#   2. `Failed with result 'oom-kill'` (see the OBS_JOBS note in bootstrap.sh)
#   3. elapsed > 180 in the TICK line; 9 of 470 ticks did this in 24 h.
#
# Reverting the cadence is a one-character edit back to *:0/4.
#
# WAS *:0/2 until 2026-08-17. Slowed so the whole box fits inside
# the Always Free ceiling of 2 OCPU / 12 GB, which Oracle halved from
# 4 OCPU / 24 GB on 2026-06-15. This instance is on a 30-day Free Trial that
# ends 2026-09-16; an A1 instance over the Always Free size is disabled at
# trial end and deleted 30 days later, so it has to shrink or start billing.
#
# Measured, not guessed. `systemctl set-property 'system-stp\x2dmrms.slice'
# CPUQuota=200%` is an exact 2-core simulation (all four tiers already share
# that slice). At a 2-minute cadence the fast tier diverged under that cap:
# 74 -> 121 -> 138 -> 181 s against a 120 s budget, work arriving faster than
# it drained. The tiers run concurrently and contend for CPU, so halving the
# most frequent one halves the dominant load.
#
# Freshness cost is small and uniform: MRMS publishes these products about
# every 2 min, so rendering every 3 adds ~1.5 min of average staleness. That
# is still well inside the freshness monitor's 20-minute OBS limit, and
# nowhere near the 21-41 min this pipeline saw on Actions before the migration.
# Per-tick work does NOT grow with the interval: these are latest-frame
# products, so a longer gap renders the newest file, not a backlog.
OnCalendar=*:0/3
# THE ONE THAT MATTERS: systemd's default AccuracySec is 60 s, which it
# spends coalescing timers to save wakeups. On a 3-minute cadence that is up
# to a third of the budget given away for nothing, and it matters more here
# than it ever has, because the tier already runs at 85% of budget. It is
# also invisible — the timer still reports as firing "every 3 minutes".
AccuracySec=1s
RandomizedDelaySec=0
# No catch-up burst after a reboot or a suspend: MRMS frames are
# latest-only, so a missed tick has nothing to replay. The next tick
# renders the newest file, which is all anyone wanted.
Persistent=false

[Install]
WantedBy=timers.target
