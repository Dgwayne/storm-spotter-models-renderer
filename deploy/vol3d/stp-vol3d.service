[Unit]
Description=STP MRMS 3D volume tiles (live v1/VOL3D/)
Documentation=https://github.com/Dgwayne/storm-spotter-models-renderer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash %h/storm-spotter-models-renderer/deploy/vol3d/run-vol3d.sh
# Per-host settings (VOL3D_ROLE, VOL3D_ENV, Nice) live in the drop-in
# ~/.config/systemd/user/stp-vol3d.service.d/role.conf that install.sh
# writes; this file is the same on every host.
# Outer fuse only. The script times ITSELF out first (VOL3D_DEADLINE_S in
# run-vol3d.sh, 300 s) with a TICK line that names the phase; this kill
# is what a hung tick hit eighteen times on 2026-09-09 while box 2 had
# no route to AWS, and a killed tick used to leave no log line at all.
TimeoutStartSec=8min
# Measured 3.1 GB peak. The cap is a fuse for this job only: if it ever
# trips, THIS tick dies instead of the box OOM-killing the L2 ingest or a
# render (the 2026-09-05 night). Raise it if a busy-day tick is killed.
MemoryMax=5G
Nice=5
