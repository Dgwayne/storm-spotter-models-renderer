[Unit]
Description=STP MRMS 3D volume tiles timer

[Timer]
# MRMS's own 3D-mosaic cadence. An unchanged stamp is a one-listing idle
# tick, so this never renders the same cycle twice. Box 2 keeps this
# default, offset one minute from its OBS fast tier (*:0/2) so the two do
# not start together. The OVH primary runs *:0/2 (install.sh drop-in) so it
# leads the fallback by a minute: by the time box 2 looks, the stamp is
# normally already up and its tick is a cheap idle.
OnCalendar=*:1/2
Persistent=false
AccuracySec=5s

[Install]
WantedBy=timers.target
