0     0   0   0   0
1     140 180 250 80
3     90  150 250 130
5     40  170 220 170
8     40  200 120 200
12    220 220 0   220
16    250 170 0   235
20    250 110 0   245
25    240 50  30  255
30    220 0   90  255
40    255 0   200 255
