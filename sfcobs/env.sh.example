#!/bin/bash
# ~/stp-sfcobs/env.sh on the Astrol box (copy of this file; no secrets here).
source ~/stp-env.sh          # PATH -> micromamba `renderer` env (netCDF4, rclone)
source ~/.stp-b2.env         # R2_BUCKET, R2_ENDPOINT, AWS_* (mode 600, by hand)
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Other
export RCLONE_CONFIG_R2_REGION=us-west-004
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
export RCLONE_CONFIG_R2_ENDPOINT="$R2_ENDPOINT"
